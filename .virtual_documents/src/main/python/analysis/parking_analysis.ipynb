



# Config notebook for retina displays
%config InlineBackend.figure_format = 'retina'

import matsim
import pandas as pd


CAR_LENGTH = 7.5
PCT = 10

df = pd.read_csv("../../../../output/berlin-autofrei-v6.4-policy/parking_occupancy_autofrei.csv")
df


# load network
network = matsim.read_network("../../../../output/berlin-autofrei-v6.4-policy/berlin-v6.4.output_network.xml.gz")
geo = network.as_geo()

geo["spots_supply"] = geo["length"] / CAR_LENGTH / PCT  # integer division or not? especially for small links relevant


# merge geo with df based on geo.link_id and df.linkId. Take all columns from geo and from_time, to_time, occupancy, initial, spots_supply, relative_occupancy from df
merged = geo.merge(
    df[['linkId', 'from_time', 'to_time', 'occupancy', 'initial']],
    left_on='link_id',
    right_on='linkId',
    how='left'
).drop(columns='linkId')

merged["relative_occupancy"] = merged["occupancy"] / merged["spots_supply"]

merged


# plot in seaborn length vs. relative_occupancy
import seaborn as sns
import matplotlib.pyplot as plt

sns.scatterplot(data=merged, x="length", y="relative_occupancy")
# add horizontal line at y=1
plt.axhline(y=1, color='r', linestyle='--')
plt.xscale("log")
plt.yscale("log")
plt.xlabel("Link Length (m)")
plt.ylabel("Relative Parking Occupancy")
plt.title("Parking Occupancy vs. Link Length")
plt.show()








import geopandas as gpd

# Convert your DataFrame to a GeoDataFrame
gdf = gpd.GeoDataFrame(merged, geometry='geometry')

# Set the coordinate reference system (your coords look like UTM)
gdf = gdf.set_crs(epsg=25832)  # Adjust EPSG code based on your data

# Plot
gdf.plot(figsize=(10, 10))
plt.show()



import folium

# Center map on data
center = gdf.geometry.unary_union.centroid
m = folium.Map(location=[center.y, center.x], zoom_start=12)

folium.GeoJson(
    gdf,
    style_function=lambda x: {"color": "blue", "weight": 2}
).add_to(m)


m



